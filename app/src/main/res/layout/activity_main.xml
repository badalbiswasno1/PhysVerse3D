<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/gl_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView android:id="@+id/label_length" android:text="দৈর্ঘ্য: 1.0"
            android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <SeekBar android:id="@+id/seek_length" android:max="100"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:id="@+id/label_width" android:text="প্রস্থ: 1.0"
            android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <SeekBar android:id="@+id/seek_width" android:max="100"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:id="@+id/label_height" android:text="উচ্চতা: 1.0"
            android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <SeekBar android:id="@+id/seek_height" android:max="100"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:id="@+id/label_time" android:text="সময়: 0.0 s (Play)"
            android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <SeekBar android:id="@+id/seek_time" android:max="100"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

    </LinearLayout>
</LinearLayout>
